# QA Automation MCP — 环境变量模板
# ⚠️ 本文件是模板, 不是配置位置。
# 插件由多人共享安装 (插件目录的 .env 会互相污染, 且更新时被重置)。
# 正确做法: 在【你自己的项目根目录】建 .env 并填入以下变量 —
# 插件启动时会自动定位用户项目根 (CLAUDE_PROJECT_DIR > 进程树嗅探 > PROJECT_DIR)
# 并加载其 .env 注入插件进程; 未找到时回退插件目录 .env。
# 用法: cp .env.example 到你的项目根为 .env, 按需修改

# 物理 Chrome 远程调试端口 (需以 --remote-debugging-port=9222 启动)
CDP_URL=http://127.0.0.1:9222

# 鼠标光标可视化 + 目标高亮 服务级默认开关
# 取值: true/false; click_interact 的 visualize 参数可对单次调用强制覆盖
VISUAL_EFFECTS=true

# ==================== 视觉识别模型 (describe_image 的 vision role) ====================
# 参考 oh-my-pi 的 role 设计: 主模型处理逻辑, 图片视觉由独立 vision role 承担。
# 仅三通道:
#   auto (默认)     — 已登录 Antigravity (凭据文件存在) 走 antigravity,
#                     否则走 tokenhub (腾讯云 GLM-5V)
#   antigravity     — Antigravity 平台 (OAuth 授权网页登录, 凭据自动管理;
#                     模型同 Gemini 族, 默认 gemini-3.6-flash)
#   tokenhub        — 腾讯云 TokenHub GLM-5V (OpenAI 兼容)
#   custom          — 任意 OpenAI 兼容端点 (需同时配 VISION_API_BASE + VISION_MODEL)
VISION_PROVIDER=auto

# Antigravity 凭据文件路径 (VISION_PROVIDER=antigravity 时)
# 默认 ~/.qa-automation-plugin/antigravity-credentials.json, 由登录命令生成:
#   python -m qa_mcp.vision_antigravity login   (打开授权网页 → 自动回调/粘贴码)
# 过期自动用 refresh_token 刷新; 端点路由可用 ANTIGRAVITY_ENDPOINT 覆盖
# (auto/production/sandbox/自定义 URL)
# ANTIGRAVITY_CREDENTIALS_FILE=
# ANTIGRAVITY_ENDPOINT=auto

# Antigravity OAuth 客户端凭证 (必须, 不随仓库提交)
# 获取: Google Cloud Console → 创建 OAuth 客户端 (Web 应用,
#       授权回调 http://127.0.0.1:51121/oauth-callback)
# 或沿用社区公开凭证 (如 oh-my-pi 项目所用)
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=

# 覆盖默认视觉模型名 (如 gemini-3.6-flash / gemini-3.6-flash-lite / glm-5v-turbo)
VISION_MODEL=

# custom provider: 任意 OpenAI 兼容端点 (含未来 antigravity API)
VISION_API_BASE=

# GLM-5V 多模态视觉 API Key (VISION_PROVIDER=tokenhub/auto 时使用)
# 接入: 腾讯云 TokenHub (OpenAI 兼容, base_url=https://tokenhub.tencentmaas.com/v1)
# 未配置时 describe_image 会明确报错; 优先级: 进程环境变量 > 本 .env 文件
VISION_API_KEY=

# 腾讯文档 MCP token (docs.qq.com/openapi/mcp 的 Authorization 头)
# 获取: 腾讯文档空间列表页 → 右上角「≡」→ 使用MCP → 获取MCP token (需超级会员, 有效期一年)
# 注意: Claude Code 暂不支持在 .mcp.json/plugin.json 的 headers 中展开 ${VAR},
#       此变量仅作本地记录, json 配置中需填入真实 token 值
TENCENT_DOCS_MCP_TOKEN=

# 可选: 元素定位等待超时 / 交互超时 (ms 或 s)
# ELEMENT_WAIT_TIMEOUT_MS=6000
# INTERACT_TIMEOUT_S=10

# 交互式 UI 工具总开关 (默认 false)
# false: 不注册 setup_form/choose/request_approval/plugin_setup/vtable_records_view
#        等长描述工具 (描述不进入上下文, 省 token), 所有交互点直接走默认逻辑
# true:  注册交互式表单/卡片 (Claude Desktop cowork 模式渲染 Apps UI)
INTERACTIVE_UI_ENABLED=false

PYTHONUNBUFFERED=1
